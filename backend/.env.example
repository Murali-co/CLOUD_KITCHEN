# =====================================================================
# BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# =====================================================================

ENVIRONMENT=development
DEBUG=True
APP_NAME="Cloud Kitchen Management API"
APP_VERSION="1.0.0"
API_V1_PREFIX=/api/v1

HOST=0.0.0.0
PORT=8000

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# MySQL 8 Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=cloud_kitchen_db
DATABASE_URL=mysql+pymysql://root:root@localhost:3306/cloud_kitchen_db?charset=utf8mb4

DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0
REDIS_DEFAULT_TTL=3600

# Security (JWT / Secret)
SECRET_KEY=dev_secret_key_cloud_kitchen_secure_key_1234567890
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
