# =====================================================================
# CLOUD KITCHEN MANAGEMENT SYSTEM - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and configure with your local environment values.
# NEVER commit the actual .env file with sensitive passwords or keys.
# =====================================================================

# Environment & Application Mode
ENVIRONMENT=development
DEBUG=True
APP_NAME="Cloud Kitchen Management API"
APP_VERSION="1.0.0"
API_V1_PREFIX=/api/v1

# Server Bind Configuration
HOST=0.0.0.0
PORT=8000

# CORS Configuration (Allowed origins separated by comma)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# MySQL Database Configuration (Primary Source of Truth)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=cloud_kitchen_db
DATABASE_URL=mysql+pymysql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}?charset=utf8mb4

# Database Connection Pool Settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# Redis In-Memory Cache Configuration (Secondary Tier)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0
REDIS_DEFAULT_TTL=3600

# Security & Future Authentication (Phase 4 Foundation)
SECRET_KEY=change_this_to_a_cryptographically_secure_random_key_in_production_32_chars_min
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
